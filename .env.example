# TypeSafe AI (Jev) の API キー。
# このファイルを .env にコピーして、右辺を実際のキーに書き換えてください。
#   cp .env.example .env
# キーの取得: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=ここにコンソールで取得したキーを貼る

# 以下は任意。未設定なら SDK の既定値が使われる。
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_LOG_LEVEL=INFO
